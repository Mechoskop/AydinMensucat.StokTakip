@inject AydinMensucat.StokTakip.Models.StokTakipContext _context

<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aydın Mensucat Depo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Şık Fontlar (Başlıklar için Playfair, Yazılar için Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,600;1,600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <!-- İkonlar için Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-ana-renk text-light">

    <div class="d-flex" style="min-height: 100vh;">

        <!-- SOL MENÜ (SIDEBAR) - Sabitlenmiş ve esnek yapıldı -->
        <aside class="sidebar-koyu d-flex flex-column p-3 position-sticky top-0" style="width: 280px; min-width: 280px; flex-shrink: 0; height: 100vh; overflow-y: auto;">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-block mb-3 marka-link">
                <small class="text-muted" style="letter-spacing: 2px; font-size:0.7rem;">DEPO DEFTERİ</small>
                <h3 class="font-baslik mt-1 mb-0">Aydın <br> <span class="text-sari fst-italic">Mensucat</span></h3>
            </a>

            <!-- Menü Linkleri (Dinamik Aktif Sınıf Kontrolü) -->
            <small class="text-muted mb-2" style="letter-spacing: 1px; font-size:0.75rem;">MENÜ</small>
            <ul class="nav nav-pills flex-column mb-auto">
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }
                <li class="nav-item mb-1">
                    <a asp-controller="Home" asp-action="Index" class="nav-link text-white @(currentController == "Home" && currentAction == "Index" ? "active-menu" : "")">
                        <i class="bi bi-house-door me-2"></i> Ana Menü
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Urun" asp-action="Index" class="nav-link text-white @(currentController == "Urun" && currentAction == "Index" ? "active-menu" : "")">
                        <i class="bi bi-grid me-2"></i> Ürün Listesi
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Urun" asp-action="Create" class="nav-link text-white @(currentController == "Urun" && currentAction == "Create" ? "active-menu" : "")">
                        <i class="bi bi-plus-lg me-2"></i> Yeni Ürün Ekle
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Urun" asp-action="Raporlar" class="nav-link text-white @(currentController == "Urun" && currentAction == "Raporlar" ? "active-menu" : "")">
                        <i class="bi bi-bar-chart-line me-2"></i> Grafik Raporları
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Urun" asp-action="StokHareketleri" class="nav-link text-white @(currentController == "Urun" && currentAction == "StokHareketleri" ? "active-menu" : "")">
                        <i class="bi bi-clock-history me-2"></i> Stok Hareket Geçmişi
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Kategori" asp-action="Index" class="nav-link text-white @(currentController == "Kategori" ? "active-menu" : "")">
                        <i class="bi bi-tags me-2"></i> Kategoriler
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Tedarikci" asp-action="Index" class="nav-link text-white @(currentController == "Tedarikci" ? "active-menu" : "")">
                        <i class="bi bi-building me-2"></i> Tedarikçiler
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a asp-controller="Musteri" asp-action="Index" class="nav-link text-white @(currentController == "Musteri" ? "active-menu" : "")">
                        <i class="bi bi-people me-2"></i> Müşteriler
                    </a>
                </li>
            </ul>

            <hr class="border-secondary my-2">

            <!-- Alt Kullanıcı Profili -->
            <div class="p-2 rounded bg-dark bg-opacity-25 border border-secondary border-opacity-25">

                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="text-white small">
                        <span class="text-muted" style="font-size: 0.75rem;">Oturum Açan:</span><br>
                        <strong class="text-sari" style="font-size: 0.9rem;">@(Context.Session.GetString("KullaniciAdi") ?? "Misafir")</strong><br>
                        <span class="text-muted" style="font-size: 0.8rem;">@(Context.Session.GetString("UserRole") == "Izleyici" ? "Salt Okunur" : "Tam Yetkili")</span>
                    </div>

                    @{
                        var digerKullanicilar = _context.Kullanicilar
                            .Where(k => k.KullaniciAdi != Context.Session.GetString("KullaniciAdi"))
                            .ToList();
                    }
                    @if (digerKullanicilar.Any())
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary border-0 text-muted p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Hesap değiştir">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark" style="font-size: 0.85rem;">
                                <li><h6 class="dropdown-header">Hesap Değiştir</h6></li>
                                @foreach (var k in digerKullanicilar)
                                {
                                    <li>
                                        <a class="dropdown-item hesap-degistir-link" href="#" data-bs-toggle="modal" data-bs-target="#hesapDegistirModal" data-kullaniciadi="@k.KullaniciAdi">
                                            <i class="bi bi-person-circle me-1"></i> @k.KullaniciAdi
                                            <small class="text-muted d-block ms-4">@(k.Rol == "Izleyici" ? "Salt Okunur" : "Tam Yetkili")</small>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>

                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm w-100 fw-bold" style="font-size: 0.8rem;">
                    <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap
                </a>
            </div>
        </aside>

        <!-- SAĞ İÇERİK (MAIN CONTENT) -->
        <main class="flex-grow-1 p-5" style="min-width: 0; overflow-x: auto;">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["ToastMesaj"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
            <div id="basariToast" class="toast align-items-center border-0 text-bg-@(TempData["ToastTip"] ?? "success")" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body fw-semibold">
                        <i class="bi @(TempData["ToastTip"]?.ToString() == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@TempData["ToastMesaj"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        </div>
        <script>
                document.addEventListener('DOMContentLoaded', function() {
                    var toastEl = document.getElementById('basariToast');
                    var toast = new bootstrap.Toast(toastEl, { delay: 3500 });
                    toast.show();
                });
        </script>
    }

    <!-- Hesap Değiştirme Modalı -->
    <div class="modal fade" id="hesapDegistirModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title font-baslik">Hesap <span class="text-sari fst-italic">Değiştir</span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p class="text-muted small mb-3">
                            <strong id="hesapDegistirKullaniciAdi" class="text-sari"></strong> hesabına geçmek için şifreyi girin.
                        </p>
                        <input type="hidden" name="kullaniciAdi" id="hesapDegistirKullaniciAdiInput" />
                        <div class="form-group">
                            <label class="form-label text-muted small">ŞİFRE</label>
                            <input type="password" name="sifre" class="form-control bg-dark text-light border-secondary" required />
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-secondary text-light" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-warning text-dark fw-bold">Giriş Yap</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Hesap değiştirme menüsünden bir kullanıcıya tıklanınca, modal içindeki gizli
         "kullaniciAdi" alanını otomatik dolduruyoruz (şifre hariç). -->
    <script>
            document.querySelectorAll('.hesap-degistir-link').forEach(function(el) {
                el.addEventListener('click', function() {
                    var kullaniciAdi = this.getAttribute('data-kullaniciadi');
                    document.getElementById('hesapDegistirKullaniciAdi').innerText = kullaniciAdi;
                    document.getElementById('hesapDegistirKullaniciAdiInput').value = kullaniciAdi;
                });
            });
    </script>
</body>
</html>