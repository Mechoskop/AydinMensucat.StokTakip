@model AydinMensucat.StokTakip.Models.Urun

@{
    ViewData["Title"] = "Ürün Transferi";
}

@await Html.PartialAsync("_SayfaBasligi", new SayfaBasligiModel
{
    DuzMetin = "Ürün ",
    VurguMetin = "Çıkışı",
    AltBaslik = "Departmana transfer veya müşteriye sevkiyat"
})
<hr class="dikis-cizgi" />

<div class="row">
    <div class="col-md-6">
        <div class="card bg-transparent border-secondary text-light shadow-sm rounded-4 p-4 mb-4">
            <h4 class="font-baslik text-sari mb-3">@ViewBag.UrunAdi</h4>
            <p class="mb-2"><strong class="text-muted">Mevcut Departman:</strong> <span class="iplik-etiket iplik-it">@ViewBag.MevcutDepartman</span></p>
            <p class="mb-4"><strong class="text-muted">Mevcut Stok:</strong> <span class="text-light" style="font-family: var(--font-mono); font-weight: 700;">@ViewBag.MevcutStok @Model.Birim</span></p>

            <!-- Bu form, controller tarafındaki tek bir Transfer POST action'ına iki farklı
                 senaryo için de veri gönderir. Hangi senaryonun aktif olduğunu radyo butonu
                 (islemTipi) belirler; JS (aşağıdaki tipDegistir fonksiyonu) sadece ilgili
                 alanı gösterip diğerini gizler, iki alan da aynı anda POST edilebilir ama
                 controller sadece dolu olanı ("hedefDepartman" veya "musteriId") dikkate alır. -->
            <form asp-action="Transfer" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label class="control-label text-muted small fw-semibold d-block mb-2">İŞLEM TÜRÜ</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="islemTipi" id="tipDepartman" value="departman" checked onclick="tipDegistir()">
                        <label class="form-check-label text-light" for="tipDepartman">Departmana Transfer</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="islemTipi" id="tipMusteri" value="musteri" onclick="tipDegistir()">
                        <label class="form-check-label text-light" for="tipMusteri">Müşteriye Çıkış Yap</label>
                    </div>
                </div>

                <!-- Senaryo 1: Departmana Transfer (varsayılan olarak görünür) -->
                <div class="form-group mb-3" id="alanDepartman">
                    <label class="control-label text-muted small fw-semibold">HEDEF DEPARTMAN</label>
                    <input type="text" name="hedefDepartman" id="hedefDepartmanInput" class="form-control bg-dark text-light border-secondary" placeholder="Örn: İnsan Kaynakları, Muhasebe..." />
                </div>

                <!-- Senaryo 2: Müşteriye Çıkış (başlangıçta d-none ile gizli) -->
                <div class="form-group mb-3 d-none" id="alanMusteri">
                    <label class="control-label text-muted small fw-semibold">MÜŞTERİ SEÇ</label>
                    <select name="musteriId" id="musteriIdInput" asp-items="ViewBag.Musteriler" class="form-select bg-dark text-light border-secondary">
                        <option value="">Müşteri Seçiniz</option>
                    </select>
                </div>

                <div class="form-group mb-4">
                    <label class="control-label text-muted small fw-semibold">MİKTAR</label>
                    <input type="number" name="transferMiktari" class="form-control bg-dark text-light border-secondary" min="1" max="@ViewBag.MevcutStok" value="1" required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4">İşlemi Gerçekleştir</button>
                    <a asp-action="Index" class="btn btn-outline-secondary text-light">Listeye Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Radyo butonuna tıklanınca hangi alanın gösterileceğine karar verir ve
    // gizlenen alanı "required" olmaktan çıkarır — yoksa tarayıcı, ekranda
    // görünmeyen ama hâlâ "zorunlu" işaretli bir alan yüzünden formu göndermeyi reddeder.
    function tipDegistir() {
        const musteriSecili = document.getElementById('tipMusteri').checked;
        const alanDepartman = document.getElementById('alanDepartman');
        const alanMusteri = document.getElementById('alanMusteri');
        const hedefInput = document.getElementById('hedefDepartmanInput');
        const musteriInput = document.getElementById('musteriIdInput');

        if (musteriSecili) {
            alanDepartman.classList.add('d-none');
            alanMusteri.classList.remove('d-none');
            hedefInput.removeAttribute('required');
            musteriInput.setAttribute('required', 'required');
        } else {
            alanMusteri.classList.add('d-none');
            alanDepartman.classList.remove('d-none');
            musteriInput.removeAttribute('required');
            hedefInput.setAttribute('required', 'required');
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}