@model IEnumerable<AydinMensucat.StokTakip.Models.StokHareketi>

@{
    ViewData["Title"] = "Stok Hareket Geçmişi";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        @await Html.PartialAsync("_SayfaBasligi", new SayfaBasligiModel
        {
            DuzMetin = "Stok Hareket ",
            VurguMetin = "Geçmişi",
            AltBaslik = "Tüm giriş, çıkış ve transfer kayıtları"
        })
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary text-light border-secondary"><i class="bi bi-arrow-left"></i> Ürün Listesine Dön</a>
</div>

<hr class="dikis-cizgi" />

<div class="card bg-transparent border-secondary shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-custom-dark align-middle mb-0" style="--bs-table-bg: transparent;">
                <thead class="text-muted small border-secondary" style="font-size: 0.75rem; letter-spacing: 1px;">
                    <tr>
                        <th class="ps-3 py-3">ÜRÜN</th>
                        <th class="py-3">
                            <a asp-action="StokHareketleri" asp-route-sortOrder="@ViewData["IslemSiralama"]" class="text-muted text-decoration-none">
                                İŞLEM TÜRÜ <i class="bi bi-arrow-down-up ms-1 sort-icon"></i>
                            </a>
                        </th>
                        <th class="py-3">DEPARTMAN</th>
                        <th class="py-3">AÇIKLAMA / SEBEP</th>
                        <th class="py-3">MİKTAR</th>
                        <th class="pe-3 py-3">
                            <a asp-action="StokHareketleri" asp-route-sortOrder="@ViewData["TarihSiralama"]" class="text-muted text-decoration-none">
                                İŞLEM TARİHİ <i class="bi bi-arrow-down-up ms-1 sort-icon"></i>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string hapSinif;
                        if (item.IslemTuru == "Yeni Ürün Eklendi") { hapSinif = "durum-yeterli"; }
                        else if (item.IslemTuru != null && item.IslemTuru.StartsWith("Müşteriye Çıkış")) { hapSinif = "durum-musteri"; }
                        else if (item.IslemTuru != null && item.IslemTuru.StartsWith("Departman Transferi")) { hapSinif = "durum-transfer"; }
                        else if (item.IslemTuru == "Stok Güncellendi") { hapSinif = "durum-azaliyor"; }
                        else if (item.IslemTuru == "Stok Azaltıldı") { hapSinif = "durum-kritik"; }
                        else if (item.IslemTuru == "Ürün Silindi") { hapSinif = "durum-kritik"; }
                        else { hapSinif = "durum-notr"; }

                        string ipSinif = item.Departman switch
                        {
                            "IT" => "iplik-it",
                            "Üretim" => "iplik-uretim",
                            "Muhasebe" => "iplik-muhasebe",
                            "Depo" => "iplik-depo",
                            _ => "iplik-it"
                        };

                        <tr class="border-secondary">
                            <td class="ps-3"><strong class="text-light">@item.UrunAdi</strong></td>
                            <td><span class="durum-hap @hapSinif">@item.IslemTuru</span></td>
                            <td><span class="iplik-etiket @ipSinif"><span class="iplik-nokta"></span>@item.Departman</span></td>
                            <td><span class="text-muted">@item.Aciklama</span></td>
                            <td><span class="miktar" style="font-family: var(--font-mono); font-weight: 700;">@item.Miktar</span></td>
                            <td class="pe-3"><span class="text-light small">@item.Tarih.ToString("dd.MM.yyyy HH:mm:ss")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>