@model AydinMensucat.StokTakip.Models.Tedarikci

@{
    ViewData["Title"] = "Yeni Tedarikçi Ekle";
}

@await Html.PartialAsync("_SayfaBasligi", new SayfaBasligiModel
{
    DuzMetin = "Yeni ",
    VurguMetin = "Tedarikçi Firması Tanımla",
    AltBaslik = "Hammadde/ekipman aldığın firmayı sisteme kaydet"
})
<hr class="dikis-cizgi" />

<div class="row">
    <div class="col-md-6">
        <div class="card bg-transparent border-secondary shadow-sm rounded-4 p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="SirketAdi" class="control-label text-muted small fw-semibold">ŞİRKET ADI</label>
                    <input asp-for="SirketAdi" class="form-control bg-dark text-light border-secondary" placeholder="Örn: Koçtaş Donanım A.Ş." required />
                    <span asp-validation-for="SirketAdi" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="YetkiliKisi" class="control-label text-muted small fw-semibold">YETKİLİ KİŞİ</label>
                    <input asp-for="YetkiliKisi" class="form-control bg-dark text-light border-secondary" placeholder="Ad Soyad" />
                    <span asp-validation-for="YetkiliKisi" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Telefon" class="control-label text-muted small fw-semibold">TELEFON</label>
                    <input asp-for="Telefon" class="form-control bg-dark text-light border-secondary" placeholder="0216 ..." />
                    <span asp-validation-for="Telefon" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Adres" class="control-label text-muted small fw-semibold">ADRES</label>
                    <textarea asp-for="Adres" class="form-control bg-dark text-light border-secondary" rows="2" placeholder="Firma adresi..."></textarea>
                    <span asp-validation-for="Adres" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Kaydet</button>
                    <a asp-action="Index" class="btn btn-outline-secondary text-light">Geri Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}