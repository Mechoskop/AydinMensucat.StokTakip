@model IEnumerable<AydinMensucat.StokTakip.Models.Kategori>
@{
    ViewData["Title"] = "Kategoriler";
    var rol = Context.Session.GetString("UserRole");
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        @await Html.PartialAsync("_SayfaBasligi", new SayfaBasligiModel
        {
            DuzMetin = "Ürün ",
            VurguMetin = "Kategorileri",
            AltBaslik = "Ürünlerin sınıflandırıldığı ana gruplar"
        })
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Urun" asp-action="Index" class="btn btn-outline-secondary text-light"><i class="bi bi-arrow-left"></i> Ürün Listesine Dön</a>
        @if (rol != "Izleyici")
        {
            <a asp-action="Create" class="btn btn-warning text-dark fw-bold">+ Yeni Kategori Ekle</a>
        }
    </div>
</div>

<hr class="dikis-cizgi" />

<div class="card bg-transparent border-secondary shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark align-middle mb-0" style="--bs-table-bg: transparent;">
                <thead class="text-muted small border-secondary" style="font-size: 0.75rem; letter-spacing: 1px;">
                    <tr>
                        <th class="ps-3 py-3">KATEGORİ ADI</th>
                        <th class="py-3">AÇIKLAMA</th>
                        <th class="py-3">ÜRÜN SAYISI</th>
                        <th class="pe-3 py-3 text-end">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-secondary">
                            <td class="ps-3"><strong class="text-light">@item.KategoriAdi</strong></td>
                            <td class="text-muted">@item.Aciklama</td>
                            <td><span style="font-family: var(--font-mono); font-weight: 700;" class="text-light">@item.Urunler.Count</span></td>
                            <td class="pe-3 text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (rol != "Izleyici")
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="icon-btn mx-1" title="İncele"><i class="bi bi-three-dots"></i></a>
                                    @if (rol != "Izleyici")
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn danger" title="Sil"><i class="bi bi-trash"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>